<Window x:Class="WpfGame.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfGame"
        mc:Ignorable="d"
        Title="Window1" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized">
    
    <Grid>
        <!-- Фон -->
        <Image x:Name="imgBackground"
           Stretch="UniformToFill"/>
        <!-- Затемнение -->
        <Rectangle Fill="Black" Opacity="0.5"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
            <TextBlock x:Name="txtTitle" Text="LOL_KEK"
                       Foreground="Aqua"
                       FontSize="48"
                       FontFamily="Bauhaus 93" 
                       Margin="0,0,0,60"
                       HorizontalAlignment="Center"/>
            <Button x:Name="btnPlay" Content="Запустить игру" Width="300" Height="67" FontSize="25" FontFamily="Georgia" Margin="0,0,0,20" Click="btnPlay_Click"/>
            <Button x:Name="btnExit" Content="Выйти" Width="300" Height="67" FontSize="25" FontFamily="Georgia" Margin="0,0,0,20" Click="btnExit_Click"/>

        </StackPanel>
    </Grid>
</Window>   
