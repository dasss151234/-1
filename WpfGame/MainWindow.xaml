<Window x:Class="WpfGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920"
        MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#f0e6d3"/>
            <Setter Property="FontSize"        Value="18"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="BorderBrush"     Value="#8b6914"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#338b6914"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8b6914"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Row 0: сцена -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: выборы -->
        </Grid.RowDefinitions>

        <!-- Фон — перекрывает оба Row -->
        <Image x:Name="imgBackground"
               Grid.Row="0" Grid.RowSpan="2"
               Stretch="UniformToFill"/>

        <!-- Затемнение поверх фона -->
        <Rectangle Grid.Row="0" Grid.RowSpan="2"
                   Fill="Black" Opacity="0.55"/>


        <!-- ══════ ROW 0 — персонаж + текст ══════ -->
        <Grid Grid.Row="0" Margin="80,60,80,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- персонаж -->
                <ColumnDefinition Width="*"/>
                <!-- текст    -->
            </Grid.ColumnDefinitions>

            <!-- Персонаж -->
            <Image x:Name="imgCharacter"
                   Grid.Column="0"
                   Width="340"
                   Stretch="Uniform"
                   VerticalAlignment="Bottom"
                   Margin="0,0,50,0"/>

            <!-- Текст сцены -->
            <Border Grid.Column="1"
                    Background="#99000000"
                    CornerRadius="12"
                    Padding="50,40"
                    VerticalAlignment="Center">
                <TextBlock x:Name="txtStory"
                           Text="Вы стоите у входа в тёмный лес..."
                           Foreground="#f0e6d3"
                           FontSize="22"
                           FontFamily="Georgia"
                           TextWrapping="Wrap"
                           LineHeight="38"/>
            </Border>
        </Grid>


        <!-- ══════ ROW 1 — список выборов ══════ -->
        <Border Grid.Row="1"
                Background="#CC000000"
                Padding="80,10,80,20">

            <ListBox x:Name="choicesList"
                     Background="Transparent"
                     BorderThickness="0"
                     MouseLeftButtonUp="choicesList_Click">

                <ListBoxItem Content="› Войти в лес"/>
                <ListBoxItem Content="› Осмотреться"/>
                <ListBoxItem Content="› Уйти прочь"/>

            </ListBox>
        </Border>

    </Grid>

</Window>